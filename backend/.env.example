# Copie para .env e preencha. Nunca versione o .env.
# Atalho para produção: python -m app.preparar (gera este arquivo com segredos fortes; veja o README).

# producao = o sistema se recusa a subir com configuração insegura (HTTPS, segredos, IA sem chave…)
AMBIENTE=desenvolvimento

# --- Identidade ---------------------------------------------------------------
# Nome exibido na tela (vazio = nenhum nome)
APP_NOME=
APP_SUBTITULO=Escritório de Recrutamento
# Empresa que recruta: aparece nos prompts ("Recrutador Sênior da empresa X") e na exportação LGPD
EMPRESA_NOME=

# --- IA -------------------------------------------------------------------------
# gemini = usa a API do Google (use o plano PAGO: no gratuito o Google pode usar o conteúdo
#          para melhorar produtos, com revisão humana — incompatível com currículos e LGPD)
# demo   = regras locais, sem enviar dados para fora (para testes)
IA_MODO=gemini
GEMINI_API_KEY=
# Modelo leve e econômico para tudo (triagem, análises, consultas e chat). A família 2.5 está sendo
# desligada pelo Google. Mais barato: gemini-3.1-flash-lite · mais forte: gemini-3.8-flash
GEMINI_MODELO=gemini-3.5-flash-lite
# Opcional: modelos diferentes para a triagem e para os agentes
# GEMINI_MODELO_TRIAGEM=gemini-3.1-flash-lite
# GEMINI_MODELO_AGENTES=gemini-3.5-flash-lite
# Raciocínio do modelo ("thinking", cobrado como saída): minimal | low | medium | high | padrao
GEMINI_PENSAMENTO=minimal
# Preço em US$ por 1 milhão de tokens, se mudar ou se o modelo não estiver na tabela interna
# GEMINI_PRECO_ENTRADA=0.30
# GEMINI_PRECO_SAIDA=2.50
# Teto de gasto estimado por dia (US$). Ao atingir, a fila de IA pausa até o dia seguinte. 0 = sem teto.
IA_LIMITE_DIARIO_USD=3
# Fuso usado para "hoje" no limite diário e nos relatórios de uso
FUSO_HORARIO=America/Sao_Paulo
IA_CONCORRENCIA=3

# --- Acesso -------------------------------------------------------------------
# rede  = servidor com login, acessado pelo navegador (HTTPS)
# local = computadores do RH: cada um roda a própria cópia, só para si e sem login (o recrutador é o usuário do
#         Windows); todos no mesmo banco (Supabase). Gere com: python -m app.preparar --local (veja o README)
ACESSO=rede
# RECRUTADOR_NOME=
# PAPEL_LOCAL=admin
# PORTA_LOCAL=8765

# --- Segurança ----------------------------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SEGREDO_JWT=
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde em cofre de senhas: sem ela os currículos cifrados não podem ser lidos.
CHAVE_ARQUIVOS=
# Chave que o fluxo de e-mail envia no cabeçalho X-API-Key ao chamar POST /triagem
TRIAGEM_API_KEY=
COOKIE_SECURE=true
SESSAO_HORAS=8
# Só se o front for servido de outro domínio (ex.: https://rh.suaempresa.com.br)
ORIGENS_CORS=

# Primeiro administrador (criado na primeira execução; troca de senha obrigatória no primeiro acesso)
ADMIN_EMAIL=rh@suaempresa.com.br
ADMIN_SENHA=
ADMIN_NOME=Administrador RH

# --- Banco ------------------------------------------------------------------------
# Padrão: SQLite em ./data. Em produção, Supabase (recomendado; veja supabase/configurar.sql e o README):
# DATABASE_URL=postgresql://hub_app.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# DB_SCHEMA=hub
# (supabase/backup.sh lê esta mesma DATABASE_URL para as cópias de segurança)
# ou um PostgreSQL próprio:
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/hub
# Onde ficam os arquivos dos currículos (sempre cifrados): disco | banco (recomendado com Supabase)
ARMAZENAMENTO=disco
PASTA_DADOS=./data

# --- LGPD ---------------------------------------------------------------------------
# Prazo de guarda sem atividade antes da anonimização automática (defina na política de privacidade)
RETENCAO_DIAS=180
# Pensamentos e conversas entre agentes (citam primeiro nome e inicial do candidato) ficam só este tempo
RETENCAO_CONVERSAS_HORAS=72
TAMANHO_MAX_MB=10

# --- Agentes -------------------------------------------------------------------------
# true = o Atlas contrata sozinho (falta de especialista, fila grande, pedidos de ajuda de uma área
#        que não existe) e libera a estação de quem está sem vagas; false = ele só propõe no quadro geral
CONTRATACAO_AUTOMATICA=true
# Média de currículos na fila por agente da mesma área que faz o Atlas reforçar o time (padrão 5; 2 na demonstração)
# LIMITE_FILA_POR_AGENTE=5
MAX_AGENTES_POR_ESPECIALIDADE=3
# Espera mínima (segundos) entre duas contratações para a mesma área (padrão 600; 30 na demonstração)
# INTERVALO_CONTRATACAO=600
# Pedidos de ajuda sem especialista (em 7 dias) que levam o Atlas a contratar alguém da área
DEMANDA_PARA_CONTRATAR=2
# Analistas consultam colegas de outra área quando têm dúvida sobre o currículo
COLABORACAO=true
# Segunda leitura: com dúvida na análise (compatibilidade média, avaliação humana ou requisito sem prova), o analista
# pede a um colega que releia o currículo procurando o que passou batido. Chance de pedir nesses casos (0 a 1).
SEGUNDA_LEITURA=true
# SEGUNDA_LEITURA_CHANCE=0.4
# Momentos da equipe: quem está livre joga pingue-pongue, toma café, conversa no bebedouro... (0 desliga).
# A IA escreve o papo até MOMENTOS_IA_POR_DIA vezes por dia; fora isso, roteiros prontos com o jeito de cada um.
# MOMENTOS_MINUTOS=4
# MOMENTOS_IA_POR_DIA=30
# Currículos sem pasta (OUTROS): o Atlas lê e encaminha quando combinam com uma vaga aberta
ENCAMINHAMENTO_AUTOMATICO=true
# Falhas de IA: o Atlas tenta de novo sozinho (até 2 vezes) depois de X minutos
REPROCESSAR_APOS_MIN=10
# Boletim do Atlas no canal da equipe, em minutos (0 desliga)
BOLETIM_MINUTOS=60
SEGUNDOS_PARA_DESCANSO=300
SEGUNDOS_CONCLUIDO=8

# --- Leitura de e-mail própria (opcional) ---------------------------------------------
# Deixe false se o fluxo de e-mail atual já chama POST /triagem
IMAP_ATIVO=false
IMAP_HOST=
# IMAP_PORTA=993
IMAP_USUARIO=
IMAP_SENHA=
IMAP_PASTA=INBOX
IMAP_INTERVALO=120

# --- Demonstração (nunca em produção) -----------------------------------------------------
SEED_DEMO=false
DEMO_INTERVALO=5
DEMO_DURACAO_ANALISE=4
# Velocidade da "digitação" do chat na demonstração (ms por palavra)
DEMO_DIGITACAO_MS=18
